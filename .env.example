# Copy to .env.local for `next dev` / `next build`, or set the same names as
# Worker secrets and variables on the Cloudflare deployment.
# Never commit real values.

# Public site origin, used for canonical URLs, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider (OpenAI-compatible). Required only for BanglaVoyage AI chat and
# AI-generated plans. Without it the planner returns a deterministic data plan.
AI_API_KEY=
AI_BASE_URL=https://freebuff.com/api/v1/paid
AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional transactional email for password resets. If unset, reset requests
# show setup guidance instead of claiming an email was sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: that sign-up email is granted the admin role automatically.
ADMIN_BOOTSTRAP_EMAIL=

# Cloudflare bindings (configured in wrangler.jsonc, not here):
#   DB     — D1 database, schema in db/migrations
#   FILES  — R2 bucket for editor image uploads
